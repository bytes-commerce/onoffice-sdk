{
    "name": "bytes-commerce/onoffice-sdk",
    "description": "Inofficial client to communicate with the onOffice API, based on the official PHP SDK.",
    "license": "MIT",
    "authors": [
        {
            "name": "onOffice GmbH"
        },
        {
            "name": "Maximilian Graf Schimmelmann",
            "email": "office@bytes-commerce.de"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "autoload": {
        "psr-4": {
            "BytesCommerce\\OnOffice\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BytesCommerce\\OnOffice\\Tests\\": "tests"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10 || ^11",
        "friendsofphp/php-cs-fixer": "^3",
        "symfony/process": "^6 || ^7",
        "rector/rector": "^1 || ^2",
        "phpstan/phpstan": "^1.10 || ^2",
        "slevomat/coding-standard": "^8",
        "symplify/easy-coding-standard": "^13.1",
        "webmozart/assert": "^1.11"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
